# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/db_name
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/test_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=booking_db
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=generate-a-secure-random-key
REFRESH_SECRET_KEY=generate-a-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Passwords for Seed
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password
MANAGER_DEFAULT_PASSWORD=your_secure_manager_password
USER_DEFAULT_PASSWORD=your_secure_user_password

# Email
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
EMAIL_FROM=noreply@example.com

# App Settings
DEBUG=true
TESTING=false
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000"]'
