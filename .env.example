# Database
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@db:5432/booking_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@db_test:5432/test_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=booking_db
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=generate-a-secure-random-key
REFRESH_SECRET_KEY=generate-a-secure-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Passwords for Seed
SEED_DEFAULT_USERS=true
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password
MANAGER_DEFAULT_PASSWORD=your_secure_manager_password
USER_DEFAULT_PASSWORD=your_secure_user_password

# Email
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password
SMTP_TIMEOUT=10
EMAIL_FROM=noreply@example.com

# Timezone & Support
TIMEZONE=UTC
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=+1234567890

# App Settings
ENVIRONMENT=development
DEBUG=false

# Optional Flower monitoring profile
FLOWER_BASIC_AUTH=admin:change-this-password
